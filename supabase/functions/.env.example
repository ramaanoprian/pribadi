# Secret Edge Functions. Lokal: salin ke supabase/functions/.env
# Produksi: npx supabase secrets set NAMA=nilai
#
# fonnte (default) | dummy (simulasi lokal, tidak mengirim apa pun)
WHATSAPP_PROVIDER=dummy
# Token perangkat dari dashboard Fonnte (jangan pernah taruh di frontend)
FONNTE_TOKEN=
# Harus sama dengan secret Vault "wa_worker_secret"
WA_WORKER_SECRET=ganti-dengan-string-acak-panjang
# Alamat website untuk tautan undangan staf
APP_URL=http://localhost:5173
