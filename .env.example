# Salin ke .env.local lalu isi dari `npx supabase status` (lokal) atau
# Project Settings > API (Supabase hosted).
# HANYA kunci publik (anon/publishable) di sini. Service role & token Fonnte
# disimpan sebagai secret Edge Function, BUKAN di frontend.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=isi-anon-key
